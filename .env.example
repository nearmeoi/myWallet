# ==========================================
# myWallet - Konfigurasi Environment
# ==========================================

# (Opsional) Supabase Cloud Backend
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# (Opsional) Database Connection String untuk script init_db.cjs
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# (Opsional) Kredensial SMTP untuk Pengingat Email Jatuh Tempo Hutang
# Atur di Vercel Environment Variables atau .env lokal
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=youremail@gmail.com
SMTP_PASS=your-google-app-password

